# LabFlow 环境变量模板
# 复制为 .env（或 application-local.yml）后填写本地值；.env 已被 .gitignore 忽略。
# 严禁把真实密码、密钥提交到仓库。

# ---- 数据库 ----
# dev 配置默认使用 H2 文件库（零安装，无需本文件即可启动）；如需 PostgreSQL 请启用 prod 配置
DB_URL=jdbc:postgresql://localhost:5432/labflow
DB_USER=labflow
DB_PASSWORD=change_me_locally
DB_POOL_SIZE=10

# ---- JWT ----
# 至少 32 字节的随机字符串，可用 `openssl rand -base64 48` 生成
JWT_SIGNING_KEY=please_generate_a_random_base64_secret_of_at_least_32_bytes
JWT_ACCESS_TTL=PT15M
JWT_REFRESH_TTL=P7D

# ---- Redis（第三阶段启用） ----
REDIS_URL=redis://localhost:6379

# ---- MinIO / SMTP（第三阶段启用） ----
MINIO_ENDPOINT=http://localhost:9000
MINIO_ACCESS_KEY=minioadmin
MINIO_SECRET_KEY=change_me_locally
SMTP_HOST=localhost
SMTP_PORT=1025

# ---- LLM（第三阶段启用） ----
LLM_BASE_URL=https://api.example.com/v1
LLM_API_KEY=
LLM_MODEL=
